{
    "name": "plotter",
    "version": "0.1.0",
    "description": "Reusable React lightmap plotting components.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/index.css"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && tsc -p tsconfig.lib.json",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@eslint/js": "^9.39.4",
        "@rolldown/plugin-babel": "^0.2.2",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.4.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.10"
    }
}
